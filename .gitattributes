# Keep LF in the repo and in every working copy. Without this, a Windows
# checkout gets CRLF and `npm run format:check` fails against Prettier's
# endOfLine: "lf" default.
* text=auto eol=lf

*.png binary

# drizzle-kit's schema snapshots: generated, and only the newest is read (by db:generate)
drizzle/migrations/meta/*_snapshot.json linguist-generated=true -diff
