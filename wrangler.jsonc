/**
 * Cloudflare Worker config for training.flyindycenter.com.
 *
 * Two things here are load-bearing for auth and must not be changed casually:
 *   - `routes` keeps us on a *.flyindycenter.com subdomain, which is the only
 *     place the browser will send identity's `fic_session` cookie.
 *   - `services.IDENTITY` is the RPC binding to the identity Worker. It is not
 *     internet-reachable and needs no secret, but it only resolves on the
 *     IndyCenter Cloudflare account.
 *
 * See .ai/decisions/0001-identity-via-service-binding.md
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "training-tools",
	"account_id": "afd63515948c9b2188ce14ef1504b2c1",
	// Our own entry, not the adapter output: it adds the roster cron (and later
	// the RPC export). The org adapter fork always writes its build to
	// .svelte-kit/cloudflare/_worker.js, which src/worker.ts imports.
	"main": "src/worker.ts",
	"compatibility_date": "2026-09-20",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"PUBLIC_IDENTITY_URL": "https://auth.flyindycenter.com",
		// The training waitlist the staff actually work. Enrollments are recorded
		// in D1 first and filed here second — see
		// .ai/decisions/0008-enrollment-record-in-d1-jira-owns-the-queue.md
		//
		// JIRA_USER_EMAIL and JIRA_API_TOKEN are secrets, not vars:
		//   wrangler secret put JIRA_USER_EMAIL
		//   wrangler secret put JIRA_API_TOKEN
		//   wrangler secret put JIRA_WEBHOOK_SECRET   (signs the TRK webhook)
		"JIRA_BASE_URL": "https://zidartcc.atlassian.net",
		"JIRA_PROJECT_KEY": "TRK"
	},
	"routes": [{ "pattern": "training.flyindycenter.com", "custom_domain": true }],
	// Roster mirror refresh. VATUSA changes slowly and the facility is ~157
	// members, so every 15 minutes is ample.
	"triggers": { "crons": ["*/15 * * * *"] },
	"services": [{ "binding": "IDENTITY", "service": "identity" }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "training-db",
			"database_id": "1bd45e96-48f1-4041-980e-9ca0e2dd3b1b",
			"migrations_dir": "./drizzle/migrations"
		}
	]
}
