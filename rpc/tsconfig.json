{
	"compilerOptions": {
		"target": "es2022",
		"module": "es2022",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"types": ["@cloudflare/workers-types"],
		"rootDir": "src",
		"outDir": "dist",
		"declaration": true,
		"emitDeclarationOnly": true
	},
	"include": ["src"]
}
